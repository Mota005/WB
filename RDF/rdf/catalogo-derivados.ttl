wsds:rdf-recursos-humanos-2017 a qb:DataSet,
        dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dct:conformsTo <https://w3id.org/ws-megsi-g7/dsd/recursos-humanos-2017> ;
    dct:description "Human resources of Portugal's 308 municipalities: total staff, by category (managers, senior technical staff, other) and by employment link (service commission, permanent and non-permanent). Number of people. Reference year: 2017. Annual period only; also includes elected representatives and political positions."@en,
        "Recursos humanos dos 308 municípios portugueses: total de trabalhadores, por tipologia (dirigentes, técnicos superiores, outros) e por vínculo (comissão de serviço, com e sem vínculo permanente). Número de pessoas. Ano de referência: 2017. Só período anual; inclui também representantes eleitos e cargos políticos."@pt ;
    dct:identifier "rdf-recursos-humanos-2017" ;
    dct:issued "2026-11-22"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-26"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:rightsHolder <https://w3id.org/ws-megsi-g7/agente/dgal> ;
    dct:source <https://dados.gov.pt/pt/datasets/recursos-humanos-2017> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/PRT> ;
    dct:temporal <https://w3id.org/ws-megsi-g7/intervalo/2017> ;
    dct:title "Human Resources 2017 — data converted to RDF"@en,
        "Recursos Humanos 2017 — dados convertidos para RDF"@pt ;
    qb:structure <https://w3id.org/ws-megsi-g7/dsd/recursos-humanos-2017> ;
    adms:versionNotes "Convertido a partir de RecursosHumanos-2017.xlsx; 0 linhas sem medidas não originaram observações; valores omissos não foram substituídos por zero; valores numéricos tipados em RDF. Só tem o período anual (A). A coluna totalrh inclui os representantes eleitos e foi convertida em g7:trabalhadoresInclEleitos; g7:trabalhadores é calculado sem os eleitos (dirigentes + técnicos superiores + outros), comparável com 2018 e 2019. Os indicadores de eleitos e de cargos políticos têm estrutura estatística própria."@pt ;
    dcat:contactPoint <https://w3id.org/ws-megsi-g7/contacto/grupo7> ;
    dcat:distribution <https://w3id.org/ws-megsi-g7/distribuicao/rdf-recursos-humanos-2017-turtle> ;
    dcat:inSeries wsds:serie-recursos-humanos ;
    dcat:keyword "employment contracts"@en,
        "human resources"@en,
        "managers"@en,
        "municipal employees"@en,
        "dirigentes"@pt,
        "recursos humanos"@pt,
        "trabalhadores municipais"@pt,
        "vínculos laborais"@pt ;
    dcat:landingPage <https://github.com/Mota005/WB> ;
    dcat:temporalResolution "P1Y"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ECON>,
        <http://publications.europa.eu/resource/authority/data-theme/GOVE> ;
    prov:wasDerivedFrom <https://dados.gov.pt/pt/datasets/recursos-humanos-2017> .

