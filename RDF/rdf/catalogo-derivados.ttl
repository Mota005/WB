        wsds:rdf-recursos-humanos-2017,
        wsds:rdf-recursos-humanos-2018,
        wsds:rdf-recursos-humanos-2019 ;
    dcat:themeTaxonomy <http://publications.europa.eu/resource/authority/data-theme> ;
    foaf:homepage <https://github.com/Mota005/WB> .

