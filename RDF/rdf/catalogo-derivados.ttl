wsds:rdf-receitas-municipais-2017 a qb:DataSet,
        dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dct:conformsTo <https://w3id.org/ws-megsi-g7/dsd/receitas-municipais> ;
    dct:description "Municipal revenue of Portugal's 308 municipalities: total revenue, State Budget transfers, EU funding, municipal taxes (IMI, IMT, IUC, corporate surcharge, fees and fines), sales of goods and services and other revenue. Values in euros; quarters are cumulative from the start of the year. Reference year: 2017. No annual (A) values: the year-end value is T4."@en,
        "Receitas municipais dos 308 municípios portugueses: receitas totais, transferências do Orçamento do Estado, financiamento da UE, impostos municipais (IMI, IMT, IUC, derrama, taxas e multas), venda de bens e serviços e outras receitas. Valores em euros; os trimestres são acumulados desde o início do ano. Ano de referência: 2017. Sem valores anuais (A): o valor de fim de ano é o de T4."@pt ;
    dct:identifier "rdf-receitas-municipais-2017" ;
    dct:issued "2026-11-22"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-26"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:rightsHolder <https://w3id.org/ws-megsi-g7/agente/dgal> ;
    dct:source <https://dados.gov.pt/pt/datasets/receitas-municipais-2017> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/PRT> ;
    dct:temporal <https://w3id.org/ws-megsi-g7/intervalo/2017> ;
    dct:title "Revenue 2017 — data converted to RDF"@en,
        "Receitas 2017 — dados convertidos para RDF"@pt ;
    qb:structure <https://w3id.org/ws-megsi-g7/dsd/receitas-municipais> ;
    adms:versionNotes "Convertido a partir de ReceitasMunicipais-2017.csv; 321 linhas sem medidas não originaram observações; valores omissos não foram substituídos por zero; valores numéricos tipados em RDF. Os valores trimestrais (T1 a T4) são acumulados desde o início do ano. O ficheiro não tem valores anuais (A); o valor de fim de ano é o de T4."@pt ;
    dcat:contactPoint <https://w3id.org/ws-megsi-g7/contacto/grupo7> ;
    dcat:distribution <https://w3id.org/ws-megsi-g7/distribuicao/rdf-receitas-municipais-2017-turtle> ;
    dcat:inSeries wsds:serie-receitas-municipais ;
    dcat:keyword "local government finance"@en,
        "municipal revenue"@en,
        "municipal taxes"@en,
        "transfers"@en,
        "finanças locais"@pt,
        "impostos municipais"@pt,
        "receitas municipais"@pt,
        "transferências"@pt ;
    dcat:landingPage <https://github.com/Mota005/WB> ;
    dcat:temporalResolution "P3M"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ECON>,
        <http://publications.europa.eu/resource/authority/data-theme/GOVE> ;
    prov:wasDerivedFrom <https://dados.gov.pt/pt/datasets/receitas-municipais-2017> .

