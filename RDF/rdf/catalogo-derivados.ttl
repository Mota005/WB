ws:catalogo a dcat:Catalog ;
    dct:description "Metadados dos 12 conjuntos RDF derivados dos ficheiros CSV/XLSX da DGAL. A ligação às páginas de origem no dados.gov.pt deve ser acrescentada quando os respetivos URIs forem verificados."@pt ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:title "Catálogo RDF de indicadores municipais da DGAL (2017–2019)"@pt ;
    dcat:dataset wsds:rdf-despesas-municipais-2017,
        wsds:rdf-despesas-municipais-2018,
        wsds:rdf-despesas-municipais-2019,
        wsds:rdf-qualidade-gestao-2017,
        wsds:rdf-qualidade-gestao-2018,
        wsds:rdf-qualidade-gestao-2019,
        wsds:rdf-receitas-municipais-2017,
        wsds:rdf-receitas-municipais-2018,
        wsds:rdf-receitas-municipais-2019,
        wsds:rdf-recursos-humanos-2017,
        wsds:rdf-recursos-humanos-2018,
        wsds:rdf-recursos-humanos-2019 .

wsds:rdf-despesas-municipais-2017 a qb:DataSet,
        dcat:Dataset ;
    dct:description "Conversão do ficheiro DGAL DespesasMunicipais-2017.csv; 1228 observações não vazias. Códigos de município e período preservados. Fonte disponível no Portal Nacional de Dados Abertos."@pt ;
    dct:identifier "rdf-despesas-municipais-2017" ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:title "Despesas 2017 — dados convertidos para RDF"@pt ;
    qb:structure <https://w3id.org/ws-megsi-g7/dsd/despesas-municipais> ;
    dcat:distribution <https://w3id.org/ws-megsi-g7/distribuicao/rdf-despesas-municipais-2017-turtle> ;
    dcat:inSeries wsds:serie-despesas-municipais .

