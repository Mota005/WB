ws:catalogo a dcat:Catalog ;
    dct:description "Catálogo de 12 conjuntos de dados em RDF/Turtle, derivados dos ficheiros CSV e XLSX da Direção-Geral das Autarquias Locais (DGAL), referentes a 2017, 2018 e 2019. Organiza os conjuntos de dados em quatro séries temáticas e descreve as respetivas distribuições, licenças, cobertura temporal e espacial e proveniência."@pt ;
    dct:issued "2026-11-22"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-24"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:title "Catálogo RDF de indicadores municipais da DGAL (2017–2019)"@pt ;
    dcat:dataset wsds:rdf-despesas-municipais-2017,
        wsds:rdf-despesas-municipais-2018,
        wsds:rdf-despesas-municipais-2019,
        wsds:rdf-qualidade-gestao-2017,
        wsds:rdf-qualidade-gestao-2018,
        wsds:rdf-qualidade-gestao-2019,
        wsds:rdf-receitas-municipais-2017,
