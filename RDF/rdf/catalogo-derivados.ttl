wsds:rdf-qualidade-gestao-2017 a qb:DataSet,
        dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dct:conformsTo <https://w3id.org/ws-megsi-g7/dsd/qualidade-gestao> ;
    dct:description "Management and financial sustainability indicators of Portugal's 308 municipalities: total debt, total revenue and expenditure, effective revenue, budget balance and overdue payments (euros); debt, revenue and expenditure execution and financial independence ratios (%); average payment period (days). Reference year: 2017."@en,
        "Indicadores de gestão e sustentabilidade financeira dos 308 municípios portugueses: dívida total, receita e despesa totais, receita efetiva, saldo orçamental e pagamentos em atraso (euros); graus de endividamento, de execução da receita e da despesa e de independência financeira (%); prazo médio de pagamento (dias). Ano de referência: 2017."@pt ;
    dct:identifier "rdf-qualidade-gestao-2017" ;
    dct:issued "2026-11-22"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-26"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:rightsHolder <https://w3id.org/ws-megsi-g7/agente/dgal> ;
    dct:source <https://dados.gov.pt/pt/datasets/qualidade-gestao-publica-2017-1> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/PRT> ;
    dct:temporal <https://w3id.org/ws-megsi-g7/intervalo/2017> ;
    dct:title "Management Quality 2017 — data converted to RDF"@en,
        "Qualidade da Gestão 2017 — dados convertidos para RDF"@pt ;
    qb:structure <https://w3id.org/ws-megsi-g7/dsd/qualidade-gestao> ;
    adms:versionNotes "Convertido a partir de QualidadeGestaoPublica-2017.xlsx; 0 linhas sem medidas não originaram observações; valores omissos não foram substituídos por zero; valores numéricos tipados em RDF. A receita total e a despesa total usam g7:receitaTotalQG e g7:despesaTotalQG, distintas das medidas das séries Receitas e Despesas."@pt ;
    dcat:contactPoint <https://w3id.org/ws-megsi-g7/contacto/grupo7> ;
    dcat:distribution <https://w3id.org/ws-megsi-g7/distribuicao/rdf-qualidade-gestao-2017-turtle> ;
    dcat:inSeries wsds:serie-qualidade-gestao ;
    dcat:keyword "budget execution"@en,
        "financial sustainability"@en,
        "indebtedness"@en,
        "public management"@en,
        "endividamento"@pt,
        "execução orçamental"@pt,
        "gestão pública"@pt,
        "sustentabilidade financeira"@pt ;
    dcat:landingPage <https://github.com/Mota005/WB> ;
    dcat:temporalResolution "P3M"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ECON>,
        <http://publications.europa.eu/resource/authority/data-theme/GOVE> ;
    prov:wasDerivedFrom <https://dados.gov.pt/pt/datasets/qualidade-gestao-publica-2017-1> .

