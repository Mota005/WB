<https://dados.gov.pt/pt/datasets/despesas-municipais-2017> a dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dct:description "Original dataset published by DGAL. Municipal expenditure of Portugal's 308 municipalities: total expenditure, current expenditure (staff, goods, interest, current transfers), investment (land and housing, buildings, basic infrastructure, accessibility, other) and capital transfers. Values in euros; quarters are cumulative. Reference year: 2017. No annual (A) values: the year-end value is T4."@en,
        "Conjunto de dados original publicado pela DGAL. Despesas municipais dos 308 municípios portugueses: despesa total, despesa corrente (pessoal, aquisição de bens, juros, transferências correntes), investimento (terrenos e habitações, edifícios, infraestruturas básicas, acessibilidades, outros) e transferências de capital. Valores em euros; os trimestres são acumulados. Ano de referência: 2017. Sem valores anuais (A): o valor de fim de ano é o de T4."@pt ;
    dct:identifier "despesas-municipais-2017" ;
    dct:issued "2018-05-04"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2018-05-14"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/dgal> ;
    dct:rightsHolder <https://w3id.org/ws-megsi-g7/agente/dgal> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/PRT> ;
    dct:temporal <https://w3id.org/ws-megsi-g7/intervalo/2017> ;
    dct:title "Municipal Expenditure 2017"@en,
        "Despesas Municipais 2017"@pt ;
    dcat:contactPoint <https://w3id.org/ws-megsi-g7/contacto/dgal> ;
    dcat:distribution <https://w3id.org/ws-megsi-g7/distribuicao/dgal-despesas-municipais-2017-csv> ;
