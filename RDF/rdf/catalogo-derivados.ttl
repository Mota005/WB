ws:catalogo a dcat:Catalog ;
    dct:description "Catalogue of 12 RDF/Turtle datasets derived from the CSV and XLSX files of the Portuguese Directorate-General for Local Authorities (DGAL) for 2017, 2018 and 2019, organised in four thematic series, together with the 12 original DGAL datasets in the Portuguese open data portal."@en,
        "Catálogo de 12 conjuntos de dados em RDF/Turtle, derivados dos ficheiros CSV e XLSX da Direção-Geral das Autarquias Locais (DGAL), referentes a 2017, 2018 e 2019. Organiza os conjuntos de dados em quatro séries temáticas e descreve as respetivas distribuições, licenças, cobertura temporal e espacial e proveniência. Descreve também os 12 conjuntos de dados originais da DGAL no Portal Nacional de Dados Abertos."@pt ;
    dct:issued "2026-11-22"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-26"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:title "RDF catalogue of DGAL municipal indicators (2017–2019)"@en,
        "Catálogo RDF de indicadores municipais da DGAL (2017–2019)"@pt ;
    dcat:dataset <https://dados.gov.pt/pt/datasets/despesas-municipais-2017>,
        <https://dados.gov.pt/pt/datasets/despesas-municipais-2018-1>,
        <https://dados.gov.pt/pt/datasets/despesas-municipais-2019>,
        <https://dados.gov.pt/pt/datasets/qualidade-gestao-publica-2017-1>,
        <https://dados.gov.pt/pt/datasets/qualidade-gestao-publica-2018-1>,
        <https://dados.gov.pt/pt/datasets/qualidade-gestao-publica-2019>,
        <https://dados.gov.pt/pt/datasets/receitas-municipais-2017>,
        <https://dados.gov.pt/pt/datasets/receitas-municipais-2018-1>,
        <https://dados.gov.pt/pt/datasets/receitas-municipais-2019>,
        <https://dados.gov.pt/pt/datasets/recursos-humanos-2017>,
        <https://dados.gov.pt/pt/datasets/recursos-humanos-2018-1>,
        <https://dados.gov.pt/pt/datasets/recursos-humanos-2019>,
        wsds:rdf-despesas-municipais-2017,
        wsds:rdf-despesas-municipais-2018,
        wsds:rdf-despesas-municipais-2019,
        wsds:rdf-qualidade-gestao-2017,
        wsds:rdf-qualidade-gestao-2018,
        wsds:rdf-qualidade-gestao-2019,
        wsds:rdf-receitas-municipais-2017,
        wsds:rdf-receitas-municipais-2018,
        wsds:rdf-receitas-municipais-2019,
        wsds:rdf-recursos-humanos-2017,
        wsds:rdf-recursos-humanos-2018,
        wsds:rdf-recursos-humanos-2019 ;
    dcat:themeTaxonomy <http://publications.europa.eu/resource/authority/data-theme> ;
    foaf:homepage <https://github.com/Mota005/WB> .

wsds:rdf-despesas-municipais-2017 a qb:DataSet,
        dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER> ;
    dct:conformsTo <https://w3id.org/ws-megsi-g7/dsd/despesas-municipais> ;
    dct:description "Municipal expenditure of Portugal's 308 municipalities: total expenditure, current expenditure (staff, goods, interest, current transfers), investment (land and housing, buildings, basic infrastructure, accessibility, other) and capital transfers. Values in euros; quarters are cumulative. Reference year: 2017. No annual (A) values: the year-end value is T4."@en,
        "Despesas municipais dos 308 municípios portugueses: despesa total, despesa corrente (pessoal, aquisição de bens, juros, transferências correntes), investimento (terrenos e habitações, edifícios, infraestruturas básicas, acessibilidades, outros) e transferências de capital. Valores em euros; os trimestres são acumulados. Ano de referência: 2017. Sem valores anuais (A): o valor de fim de ano é o de T4."@pt ;
    dct:identifier "rdf-despesas-municipais-2017" ;
    dct:issued "2026-11-22"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/POR> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-26"^^xsd:date ;
    dct:publisher <https://w3id.org/ws-megsi-g7/agente/grupo7> ;
    dct:rightsHolder <https://w3id.org/ws-megsi-g7/agente/dgal> ;
    dct:source <https://dados.gov.pt/pt/datasets/despesas-municipais-2017> ;
    dct:spatial <http://publications.europa.eu/resource/authority/country/PRT> ;
    dct:temporal <https://w3id.org/ws-megsi-g7/intervalo/2017> ;
    dct:title "Expenditure 2017 — data converted to RDF"@en,
        "Despesas 2017 — dados convertidos para RDF"@pt ;
    qb:structure <https://w3id.org/ws-megsi-g7/dsd/despesas-municipais> ;
    adms:versionNotes "Convertido a partir de DespesasMunicipais-2017.csv; 4 linhas sem medidas não originaram observações; valores omissos não foram substituídos por zero; valores numéricos tipados em RDF. Os valores trimestrais (T1 a T4) são acumulados desde o início do ano. O ficheiro não tem valores anuais (A); o valor de fim de ano é o de T4."@pt ;
    dcat:contactPoint <https://w3id.org/ws-megsi-g7/contacto/grupo7> ;
    dcat:distribution <https://w3id.org/ws-megsi-g7/distribuicao/rdf-despesas-municipais-2017-turtle> ;
    dcat:inSeries wsds:serie-despesas-municipais ;
    dcat:keyword "investment"@en,
        "local government finance"@en,
        "municipal expenditure"@en,
        "personnel costs"@en,
        "despesas com pessoal"@pt,
        "despesas municipais"@pt,
        "finanças locais"@pt,
        "investimento"@pt ;
    dcat:landingPage <https://github.com/Mota005/WB> ;
    dcat:temporalResolution "P3M"^^xsd:duration ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/ECON>,
        <http://publications.europa.eu/resource/authority/data-theme/GOVE> ;
    prov:wasDerivedFrom <https://dados.gov.pt/pt/datasets/despesas-municipais-2017> .

