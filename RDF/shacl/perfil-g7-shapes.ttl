    sh:property [ sh:path g7:investOutros ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "g7:investOutros: um único valor, tipado como xsd:decimal."@pt ] .

g7sh:Medida_investTerrenosHabitacoes a sh:NodeShape ;
    sh:targetSubjectsOf g7:investTerrenosHabitacoes ;
    sh:property [ sh:path g7:investTerrenosHabitacoes ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "g7:investTerrenosHabitacoes: um único valor, tipado como xsd:decimal."@pt ] .

g7sh:Medida_investimentoTotal a sh:NodeShape ;
    sh:targetSubjectsOf g7:investimentoTotal ;
    sh:property [ sh:path g7:investimentoTotal ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "g7:investimentoTotal: um único valor, tipado como xsd:decimal."@pt ] .

g7sh:Medida_iuc a sh:NodeShape ;
    sh:targetSubjectsOf g7:iuc ;
    sh:property [ sh:path g7:iuc ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "g7:iuc: um único valor, tipado como xsd:decimal."@pt ] .

g7sh:Medida_jurosEncargos a sh:NodeShape ;
    sh:targetSubjectsOf g7:jurosEncargos ;
    sh:property [ sh:path g7:jurosEncargos ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "g7:jurosEncargos: um único valor, tipado como xsd:decimal."@pt ] .

g7sh:Medida_outrasReceitas a sh:NodeShape ;
    sh:targetSubjectsOf g7:outrasReceitas ;
    sh:property [ sh:path g7:outrasReceitas ; sh:maxCount 1 ; sh:datatype xsd:decimal ;
        sh:message "g7:outrasReceitas: um único valor, tipado como xsd:decimal."@pt ] .

g7sh:Medida_outrosTrabalhadores a sh:NodeShape ;
    sh:targetSubjectsOf g7:outrosTrabalhadores ;
    sh:property [ sh:path g7:outrosTrabalhadores ; sh:maxCount 1 ; sh:datatype xsd:integer ;
