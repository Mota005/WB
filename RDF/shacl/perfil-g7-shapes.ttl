# ---------- Impressão digital das distribuições originais (spdx:checksum, DCAT-AP) ----------
g7sh:Checksum a sh:NodeShape ; sh:targetClass <http://spdx.org/rdf/terms#Checksum> ;
    sh:property [ sh:path <http://spdx.org/rdf/terms#algorithm> ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:hasValue <http://spdx.org/rdf/terms#checksumAlgorithm_sha256> ] ;
    sh:property [ sh:path <http://spdx.org/rdf/terms#checksumValue> ; sh:minCount 1 ; sh:maxCount 1 ;
                  sh:datatype xsd:hexBinary ; sh:pattern "^[0-9a-f]{64}$" ;
                  sh:message "SHA-256 com 64 caracteres hexadecimais."@pt ] .
