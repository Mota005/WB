@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ws-megsi-g7/vocab> a owl:Ontology ;
    dct:description "Proposta de vocabulário RDF para medidas específicas de quatro séries anuais da DGAL (2017-2019) e medidas de enriquecimento do INE. Identificadores URI ainda por registar/publicar."@pt ;
    dct:title "Vocabulário de indicadores municipais do Grupo 7"@pt ;
    owl:versionInfo "0.1.0 — proposta a validar pela docente" .

g7:ano a qb:DimensionProperty,
        rdf:Property ;
    rdfs:label "Reference year"@en,
        "Ano de referência"@pt ;
    rdfs:comment "Ano civil dos dados, de 2017 a 2019; dimensão proposta, sujeita a reavaliação face a sdmx-dimension:refPeriod."@pt ;
    rdfs:range xsd:gYear .

g7:cargosPoliticos a qb:MeasureProperty,
        rdf:Property ;
    rdfs:label "Political positions and mandates"@en,
        "Cargos e mandatos políticos"@pt ;
    dct:identifier "cargosmandatospoliticos" ;
    sdmx-attribute:unitMeasure unit:NUM ;
    rdfs:comment "Indicador correspondente à coluna cargosmandatospoliticos dos ficheiros Recursos Humanos. A definição contabilística exata deve ser confirmada na documentação da fonte."@pt ;
    rdfs:range xsd:integer ;
    rdfs:subPropertyOf sdmx-measure:obsValue .

g7:comissaoServico a qb:MeasureProperty,
        rdf:Property ;
    rdfs:label "Employees on service commission"@en,
        "Trabalhadores em comissão de serviço"@pt ;
